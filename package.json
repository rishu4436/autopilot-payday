    "live:discover": "tsx scripts/live-discover.ts",
    "live:challenge": "tsx scripts/live-challenge.ts",
    "live:paid-quote": "tsx scripts/live-paid-quote.ts",
    "lint": "eslint src services scripts e2e *.ts *.mjs",
    "live:prepare-quote": "tsx scripts/prepare-paid-quote.ts",
    "live:reconcile": "tsx scripts/reconcile-payment.ts",
    "live:recover-lock": "tsx scripts/recover-signer-lock.ts",
    "live:import-evidence": "tsx scripts/import-paid-evidence.ts"
