# Autopilot Payday
# Copy to .env.local. Never put a private key in this file or in the hosted app.

# demo | live_readonly | live
APP_MODE=demo
APP_ORIGIN=http://127.0.0.1:3100
# Only for local production-build previews over HTTP loopback. Hosted HTTPS keeps secure cookies.
COOKIE_SECURE=false

# Local embedded Postgres (default). Set DATABASE_URL to use an external Postgres instead.
# DATABASE_URL=postgres://autopilot:autopilot@localhost:5432/autopilot
PGLITE_DIR=./data/pglite

# External databases are never seeded unless explicitly marked as a dedicated demo database.
ALLOW_DEMO_SEED=false

# Server-side Solana RPC. A public endpoint works for reads and is rate limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional independent read-only verifier; prefer a different trusted mainnet provider.
# SOLANA_VERIFICATION_RPC_URL=https://your-independent-mainnet-rpc.example
SOLANA_CLUSTER=mainnet-beta

# Public RPC used only by the browser wallet adapter. Prefer server broadcast.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

HERMES_BASE_URL=https://hermes.swap.io

# Public address of the dedicated x402 payer. The secret never belongs in the web app.
X402_PAYER_PUBLIC_KEY=

# The web app has no signer credentials or relay. Configure the opt-in local CLI
# in its own private terminal according to AUDIT-LIVE-RUNBOOK.md.

# Web financial execution is quarantined in code, regardless of this variable.
LIVE_OPERATIONS=false
# Managed treasury signing remains off until independent review and separate owner approvals.
TREASURY_EXECUTION_ENABLED=false
# Set only after review; the marker acknowledges review, it does not certify it.
# TREASURY_REVIEWED_RELEASE=controlled-swap-payroll-v1

# Path read only by services/x402-signer and scripts/live-paid-quote.ts
# PAYER_KEYPAIR must point outside this repository. Set it only in the private
# signer terminal; see AUDIT-LIVE-RUNBOOK.md. Never add it to this web env file.
