  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.32",
      "tinypool": "^2.1.2",
      "bigint-buffer": "file:vendor/bigint-buffer",
      "zod": "^4.6.7",
      "jayson": "^5.0.0",
