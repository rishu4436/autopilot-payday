{
  "name": "autopilot-payday",
  "version": "1.0.0",
  "private": true,
  "description": "Autopilot Payday - AI-assisted Solana treasury operations, x402 agent funding, and contributor payroll.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "tsx src/db/cli.ts seed",
